# Copy this file to .env and fill in values for your own node.
# Never commit a real .env file.

NODE_NAME=My Ravencoin Node

BIND_HOST=0.0.0.0
BIND_PORT=8899
POLL_INTERVAL=10

# --- Ravencoin Core RPC ---
CORE_RPC_HOST=127.0.0.1
CORE_RPC_PORT=8766
CORE_RPC_USER=changeme
CORE_RPC_PASSWORD=changeme
# Or, instead of the two lines above, point at files (e.g. Docker/Compose
# secrets) and leave CORE_RPC_USER/CORE_RPC_PASSWORD unset:
# CORE_RPC_USER_FILE=/run/secrets/raven_rpc_user
# CORE_RPC_PASSWORD_FILE=/run/secrets/raven_rpc_password
CORE_RPC_TIMEOUT=8

# --- Mempool ---
MEMPOOL_TX_LIMIT=200
MEMPOOL_CLASSIFY=true
MEMPOOL_CLASSIFY_LIMIT=300

# --- ElectrumX (optional) ---
# auto: probe silently, hide the section if unreachable (default)
# true: always try, show a visible error if it fails
# false: never probe, standalone-Core mode only
ELECTRUMX_ENABLED=auto
ELECTRUMX_RPC_HOST=127.0.0.1
ELECTRUMX_RPC_PORT=8000
ELECTRUMX_SSL_HOST=127.0.0.1
ELECTRUMX_SSL_PORT=50002
# Only needed if your TLS cert's SNI/hostname differs from ELECTRUMX_SSL_HOST:
# ELECTRUMX_SSL_SNI=electrumx.example.com
ELECTRUMX_SSL_VERIFY=false

# Set to "file" if the admin RPC is locked to 127.0.0.1 inside its own
# container and you're using contrib/electrumx-admin-poller.py instead of
# reaching rpc:// directly (see README "Core + ElectrumX bundle"):
# ELECTRUMX_ADMIN_SOURCE=file
# ELECTRUMX_ADMIN_FILE=/data/electrumx-admin.json
# ELECTRUMX_ADMIN_MAX_AGE=60

# --- RVN/USDT price feed (Binance public API, disabled by default) ---
PRICE_FEED_ENABLED=false
PRICE_FEED_SYMBOL=RVNUSDT
PRICE_POLL_INTERVAL=300

# --- Extra disks (optional) ---
# Report disk usage for additional mounted volumes beyond the root
# filesystem, e.g. blockchain data stored on a separate drive. Give each
# entry a "Label=" or leave it bare - bare entries are auto-numbered
# ("Disk 1", "Disk 2", ...) with a best-effort SSD/HDD hint appended:
# EXTRA_DISK_PATHS=Blockchain data=/mnt/blockchain-data,/mnt/backup
