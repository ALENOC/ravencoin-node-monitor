# Copy this file to .env and fill in values for your own node.
# Never commit a real .env file.

NODE_NAME=My Ravencoin Node

BIND_HOST=0.0.0.0
BIND_PORT=8899
POLL_INTERVAL=10

# --- Dashboard access hardening ---
# By default the HTTP server accepts Host headers that are localhost or
# private/loopback/link-local IP literals. If you browse through a DNS name
# or reverse proxy hostname, list it here (comma-separated, hostnames only):
# MONITOR_ALLOWED_HOSTS=node.local,monitor.example.internal
MONITOR_ALLOWED_HOSTS=
# Optional HTTP Basic authentication. When MONITOR_PASSWORD (or its _FILE
# variant) is set, the dashboard, APIs, and /metrics require credentials;
# /healthz and /readyz intentionally remain unauthenticated for probes.
# MONITOR_USER=monitor
# MONITOR_PASSWORD=choose-a-strong-password
# MONITOR_PASSWORD_FILE=/run/secrets/monitor_password

# --- Ravencoin Core RPC ---
CORE_RPC_HOST=127.0.0.1
CORE_RPC_PORT=8766
CORE_RPC_USER=changeme
CORE_RPC_PASSWORD=changeme
# Or, instead of the two lines above, point at files (e.g. Docker/Compose
# secrets) and leave CORE_RPC_USER/CORE_RPC_PASSWORD unset:
# CORE_RPC_USER_FILE=/run/secrets/raven_rpc_user
# CORE_RPC_PASSWORD_FILE=/run/secrets/raven_rpc_password
CORE_RPC_TIMEOUT=8

# --- Mempool ---
MEMPOOL_TX_LIMIT=200
MEMPOOL_CLASSIFY=true
MEMPOOL_CLASSIFY_LIMIT=300

# --- ElectrumX (optional) ---
# auto: probe silently, hide the section if unreachable (default)
# true: always try, show a visible error if it fails
# false: never probe, standalone-Core mode only
ELECTRUMX_ENABLED=auto
ELECTRUMX_RPC_HOST=127.0.0.1
ELECTRUMX_RPC_PORT=8000
ELECTRUMX_SSL_HOST=127.0.0.1
ELECTRUMX_SSL_PORT=50002
# Only needed if your TLS cert's SNI/hostname differs from ELECTRUMX_SSL_HOST:
# ELECTRUMX_SSL_SNI=electrumx.example.com
# Unverified TLS is accepted only for local/private IPs, localhost, .local,
# or single-label LAN/Docker service names. Remote/FQDN targets must use a
# certificate valid for ELECTRUMX_SSL_SNI and set this to true.
ELECTRUMX_SSL_VERIFY=false

# Set to "file" if the admin RPC is locked to 127.0.0.1 inside its own
# container and you're using contrib/electrumx-admin-poller.py instead of
# reaching rpc:// directly (see README "Core + ElectrumX bundle"):
# ELECTRUMX_ADMIN_SOURCE=file
# ELECTRUMX_ADMIN_FILE=/data/electrumx-admin.json
# ELECTRUMX_ADMIN_MAX_AGE=60

# --- RVN/USDT price feed (Binance public API, disabled by default) ---
PRICE_FEED_ENABLED=false
PRICE_FEED_SYMBOL=RVNUSDT
PRICE_POLL_INTERVAL=300

# --- Extra disks (optional) ---
# Report disk usage for additional mounted volumes beyond the root
# filesystem (shown as "Disk 1"), e.g. blockchain data stored on a
# separate drive. Give each entry a "Label=" or leave it bare - bare
# entries are auto-numbered "Disk 2", "Disk 3", ...:
# EXTRA_DISK_PATHS=Blockchain data=/mnt/blockchain-data,/mnt/backup

# --- History (RAM-only by default - see README "History storage") ---
HISTORY_ENABLED=true
# "memory" (default): SQLite :memory:, nothing is ever written to disk,
# history resets on every restart. "sqlite": opt-in, writes HISTORY_DB_PATH.
HISTORY_STORAGE=memory
# HISTORY_DB_PATH=/data/history.db
HISTORY_SAMPLE_INTERVAL=60
HISTORY_RETENTION_HOURS=168
HISTORY_MAX_SAMPLES=20160
EVENT_HISTORY_MAX=2000

# --- Privacy ---
# Masks IPs server-side in peer/ElectrumX-client addresses (192.168.1.123
# -> 192.168.x.x). .onion addresses are left alone (not real IPs).
PRIVACY_MODE=false

# --- Prometheus ---
PROMETHEUS_ENABLED=true

# --- Core version check (optional, fully offline - no internet access) ---
# MIN_SAFE_CORE_VERSION=4.8.0

# --- Health thresholds ---
HEALTH_MIN_PEERS=4
DISK_WARNING_PERCENT=80
DISK_CRITICAL_PERCENT=90
ELECTRUMX_WARNING_LAG=3
ELECTRUMX_CRITICAL_LAG=10
CHAIN_STALE_WARNING_SECONDS=900
CHAIN_STALE_CRITICAL_SECONDS=1800
RPC_LATENCY_WARNING_MS=2000

# --- Alert webhook (optional, disabled unless a URL is set) ---
# ALERT_WEBHOOK_URL=https://example.com/your-webhook
ALERT_MIN_SEVERITY=warning
ALERT_COOLDOWN_SECONDS=900
